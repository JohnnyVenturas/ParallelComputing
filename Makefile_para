SRC_DIR=src_para
HEADER_DIR=include
OBJ_DIR=obj_para
OBJ_DIR_NO_MPI=obj_para_no_mpi

# Get MPI directory paths
MPI_DIR=/users/profs/2016/patrick.carribault/local/openmpi/build/../install
MPI_LIB=$(MPI_DIR)/lib
MPI_INC=$(MPI_DIR)/include

# CUDA compiler with appropriate flags
CC=nvcc -I.

# OpenMP flags for CUDA
OPENMP_FLAGS=-Xcompiler -fopenmp

# MPI flags need special handling for nvcc
MPI_INC_FLAGS=-Xcompiler -I$(MPI_INC)
MPI_LIB_FLAGS=-L$(MPI_LIB) -lmpi -Xcompiler -pthread

# Combine flags
CFLAGS=-O3 -g -I$(HEADER_DIR) $(OPENMP_FLAGS) $(MPI_INC_FLAGS)
CFLAGS_NO_MPI=-O3 -g -I$(HEADER_DIR) $(OPENMP_FLAGS)
LDFLAGS=-lm $(OPENMP_FLAGS) $(MPI_LIB_FLAGS)
LDFLAGS_NO_MPI=-lm $(OPENMP_FLAGS)

# Source files for MPI version
SRC= $(SRC_DIR)/dgif_lib_para.c \
     $(SRC_DIR)/egif_lib_para.c \
     $(SRC_DIR)/gif_err_para.c \
     $(SRC_DIR)/gif_font_para.c \
     $(SRC_DIR)/gif_hash_para.c \
     $(SRC_DIR)/gifalloc_para.c \
     $(SRC_DIR)/main_para.cu \
     $(SRC_DIR)/openbsd-reallocarray_para.c \
     $(SRC_DIR)/quantize_para.c

# Source files for non-MPI version (same except for main file)
SRC_NO_MPI= $(SRC_DIR)/dgif_lib_para.c \
            $(SRC_DIR)/egif_lib_para.c \
            $(SRC_DIR)/gif_err_para.c \
            $(SRC_DIR)/gif_font_para.c \
            $(SRC_DIR)/gif_hash_para.c \
            $(SRC_DIR)/gifalloc_para.c \
            $(SRC_DIR)/main_para_without_MPI.cu \
            $(SRC_DIR)/openbsd-reallocarray_para.c \
            $(SRC_DIR)/quantize_para.c

# Object files for MPI version
OBJ= $(OBJ_DIR)/dgif_lib_para.o \
     $(OBJ_DIR)/egif_lib_para.o \
     $(OBJ_DIR)/gif_err_para.o \
     $(OBJ_DIR)/gif_font_para.o \
     $(OBJ_DIR)/gif_hash_para.o \
     $(OBJ_DIR)/gifalloc_para.o \
     $(OBJ_DIR)/main_para.o \
     $(OBJ_DIR)/openbsd-reallocarray_para.o \
     $(OBJ_DIR)/quantize_para.o

# Object files for non-MPI version
OBJ_NO_MPI= $(OBJ_DIR_NO_MPI)/dgif_lib_para.o \
            $(OBJ_DIR_NO_MPI)/egif_lib_para.o \
            $(OBJ_DIR_NO_MPI)/gif_err_para.o \
            $(OBJ_DIR_NO_MPI)/gif_font_para.o \
            $(OBJ_DIR_NO_MPI)/gif_hash_para.o \
            $(OBJ_DIR_NO_MPI)/gifalloc_para.o \
            $(OBJ_DIR_NO_MPI)/main_para_without_MPI.o \
            $(OBJ_DIR_NO_MPI)/openbsd-reallocarray_para.o \
            $(OBJ_DIR_NO_MPI)/quantize_para.o

.PHONY: all clean run run_no_mpi

all: mpi no_mpi

mpi: $(OBJ_DIR) sobel_para

no_mpi: $(OBJ_DIR_NO_MPI) sobel_para_without_MPI

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

$(OBJ_DIR_NO_MPI):
	mkdir -p $(OBJ_DIR_NO_MPI)

### Rules for MPI version
# Rule for C files (MPI version)
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Rule for CUDA files (MPI version)
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cu
	$(CC) $(CFLAGS) -c -o $@ $<

#### Rules for non-MPI version
# Rule for C files (non-MPI version)
$(OBJ_DIR_NO_MPI)/%.o: $(SRC_DIR)/%.c
	$(CC) $(CFLAGS_NO_MPI) -c -o $@ $<

# Rule for CUDA files (non-MPI version)
$(OBJ_DIR_NO_MPI)/%.o: $(SRC_DIR)/%.cu
	$(CC) $(CFLAGS_NO_MPI) -c -o $@ $<

# Special rule for main_para_without_MPI.cu
$(OBJ_DIR_NO_MPI)/main_para_without_MPI.o: $(SRC_DIR)/main_para_without_MPI.cu
	$(CC) $(CFLAGS_NO_MPI) -c -o $@ $<

# Build targets
sobel_para: $(OBJ)
	$(CC) -o $@ $^ $(LDFLAGS)

sobel_para_without_MPI: $(OBJ_NO_MPI)
	$(CC) -o $@ $^ $(LDFLAGS_NO_MPI)





clean:
	rm -rf sobel_para sobel_para_without_MPI $(OBJ_DIR) $(OBJ_DIR_NO_MPI)