SRC_DIR=src_para
HEADER_DIR=include
OBJ_DIR=obj_para

# CUDA compiler
CC=nvcc -I.

# OpenMP flags for CUDA
# -Xcompiler flag passes options to the underlying host compiler
OPENMP_FLAGS=-Xcompiler -fopenmp

# Combine flags
CFLAGS=-O3 -g -I$(HEADER_DIR) $(OPENMP_FLAGS)
LDFLAGS=-lm -Xcompiler -fopenmp

SRC= $(SRC_DIR)/dgif_lib_para.c \
     $(SRC_DIR)/egif_lib_para.c \
     $(SRC_DIR)/gif_err_para.c \
     $(SRC_DIR)/gif_font_para.c \
     $(SRC_DIR)/gif_hash_para.c \
     $(SRC_DIR)/gifalloc_para.c \
     $(SRC_DIR)/main_para.cu \
     $(SRC_DIR)/openbsd-reallocarray_para.c \
     $(SRC_DIR)/quantize_para.c

OBJ= $(OBJ_DIR)/dgif_lib_para.o \
     $(OBJ_DIR)/egif_lib_para.o \
     $(OBJ_DIR)/gif_err_para.o \
     $(OBJ_DIR)/gif_font_para.o \
     $(OBJ_DIR)/gif_hash_para.o \
     $(OBJ_DIR)/gifalloc_para.o \
     $(OBJ_DIR)/main_para.o \
     $(OBJ_DIR)/openbsd-reallocarray_para.o \
     $(OBJ_DIR)/quantize_para.o

.PHONY: all clean

all: $(OBJ_DIR) sobelf_para

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

# Rule for C files
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Rule for CUDA files
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cu
	$(CC) $(CFLAGS) -c -o $@ $<

sobelf_para: $(OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

clean:
	rm -rf sobelf_para $(OBJ_DIR)