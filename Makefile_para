SRC_DIR=src_para
HEADER_DIR=include
OBJ_DIR=obj_para

CC=/usr/bin/gcc
CFLAGS=-O3 -fopenmp -I$(HEADER_DIR)
LDFLAGS=-lm

SRC= dgif_lib_para.c \
    egif_lib_para.c \
    gif_err_para.c \
    gif_font_para.c \
    gif_hash_para.c \
    gifalloc_para.c \
    main_para.c \
    openbsd-reallocarray_para.c \
    quantize_para.c

OBJ= $(OBJ_DIR)/dgif_lib_para.o \
    $(OBJ_DIR)/egif_lib_para.o \
    $(OBJ_DIR)/gif_err_para.o \
    $(OBJ_DIR)/gif_font_para.o \
    $(OBJ_DIR)/gif_hash_para.o \
    $(OBJ_DIR)/gifalloc_para.o \
    $(OBJ_DIR)/main_para.o \
    $(OBJ_DIR)/openbsd-reallocarray_para.o \
    $(OBJ_DIR)/quantize_para.o

all: $(OBJ_DIR) sobelf_para

$(OBJ_DIR):
    mkdir $(OBJ_DIR)

$(OBJ_DIR)/%.o : $(SRC_DIR)/%.c
    $(CC) $(CFLAGS) -c -o $@ $^

sobelf_para:$(OBJ)
    $(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

clean:
    rm -f sobelf_para $(OBJ)