SRC_DIR=src_para
HEADER_DIR=include
OBJ_DIR=obj_para

CC=mpicc
CFLAGS=-O3 -I$(HEADER_DIR)
LDFLAGS=-lm -fopenmp

SRC= dgif_lib.c \
	egif_lib.c \
	gif_err.c \
	gif_font.c \
	gif_hash.c \
	gifalloc.c \
	main_mpi.c \
	openbsd-reallocarray.c \
	quantize.c

OBJ_COMMON= $(OBJ_DIR)/dgif_lib.o \
	$(OBJ_DIR)/egif_lib.o \
	$(OBJ_DIR)/gif_err.o \
	$(OBJ_DIR)/gif_font.o \
	$(OBJ_DIR)/gif_hash.o \
	$(OBJ_DIR)/gifalloc.o \
	$(OBJ_DIR)/openbsd-reallocarray.o \
	$(OBJ_DIR)/quantize.o

OBJ_MAIN_MPI=$(OBJ_COMMON) $(OBJ_DIR)/main_mpi.o

all: $(OBJ_DIR) sobel_mpi

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

$(OBJ_DIR)/%.o : $(SRC_DIR)/%.c
	$(CC) $(CFLAGS) -c -o $@ $^

sobelf: $(OBJ_MAIN)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

sobelf_mpi: $(OBJ_MAIN_MPI)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

clean:
	rm -f sobelf sobelf2 $(OBJ_DIR)/*.o

